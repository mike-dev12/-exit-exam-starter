# Copy this file to .env.local and fill in your real values
# Find these in your Supabase project: Settings -> API

NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# SERVER ONLY (never prefix with NEXT_PUBLIC_). Settings -> API -> service_role key.
# Needed so the admin can delete users. Also add it in Vercel -> Environment Variables.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# OPTIONAL: shows "N days to your exam" on the student dashboard (YYYY-MM-DD)
# NEXT_PUBLIC_EXAM_DATE=2026-12-15
